#X text 40 660 LCD lines go to O2O (OLED) as /display-strings-and-numbers <line1> \\n <line2>;
#X obj 700 260 loadbang;
#X msg 700 290 \; bela_setMidi hw 0 0 0;
#X text 700 320 opens hw:0 \, 0 \, 0 = Bela as USB MIDI device of the computer (Ableton etc.);
