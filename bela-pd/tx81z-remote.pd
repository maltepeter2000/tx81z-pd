#N canvas 80 80 820 420 12;
#X text 20 10 TX81Z Bela remote - front panel buttons via OSC to the Bela (UDP 7563);
#X msg 20 45 connect 192.168.7.2 7563;
#X msg 220 45 disconnect;
#X obj 20 330 netsend -u -b;
#X floatatom 20 360 3 0 0 0 - - - 0;
#X text 60 360 1 = connected;
#X obj 20 270 oscformat tx81z press;
#X obj 20 295 list prepend send;
#X obj 170 295 list trim;
#X msg 20 90 symbol play;
#X msg 130 90 symbol edit;
#X msg 240 90 symbol utility;
#X msg 350 90 symbol store;
#X msg 460 90 symbol param-;
#X msg 20 120 symbol param+;
#X msg 130 120 symbol dec;
#X msg 240 120 symbol inc;
#X msg 350 120 symbol vol-;
#X msg 460 120 symbol vol+;
#X msg 20 150 symbol cursor;
#X text 20 190 MASTER VOLUME = vol- / vol+ (in PLAY mode);
#X obj 400 270 oscformat tx81z pgm;
#X floatatom 400 220 4 0 127 0 - - - 0;
#X text 450 220 program change 0-127 (C15 LatelyBass = 110);
#X connect 9 0 6 0;
#X connect 10 0 6 0;
#X connect 11 0 6 0;
#X connect 12 0 6 0;
#X connect 13 0 6 0;
#X connect 14 0 6 0;
#X connect 15 0 6 0;
#X connect 16 0 6 0;
#X connect 17 0 6 0;
#X connect 18 0 6 0;
#X connect 19 0 6 0;
#X connect 22 0 21 0;
#X connect 21 0 7 0;
#X connect 1 0 3 0;
#X connect 2 0 3 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 3 0;
#X connect 3 0 4 0;
