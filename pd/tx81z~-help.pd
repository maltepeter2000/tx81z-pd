#N canvas 100 60 960 1020 12;
#X text 20 10 tx81z~ - Yamaha TX81Z emulator (original firmware \, ymfm OPZ);
#X text 20 32 args: firmware file and battery RAM file (relative to this patch);
#X obj 40 330 tx81z~ tx81z-v1.6.bin tx81z.nvram;
#X msg 640 60 \; pd dsp 1;
#X msg 720 60 \; pd dsp 0;
#X obj 40 70 midiin;
#X text 100 70 <- raw MIDI from your keyboard / DAW;
#X msg 40 110 note 36 100;
#X msg 135 110 note 36 0;
#X msg 230 110 note 48 100;
#X msg 325 110 note 48 0;
#X msg 430 110 pgm 0;
#X msg 40 150 press store;
#X msg 145 150 press utility;
#X msg 250 150 press edit;
#X msg 355 150 press play;
#X msg 460 150 press param-;
#X msg 40 178 press param+;
#X msg 145 178 press dec;
#X msg 250 178 press inc;
#X msg 355 178 press vol-;
#X msg 460 178 press vol+;
#X msg 40 206 press cursor;
#X text 640 150 front panel buttons;
#X msg 40 245 save;
#X msg 90 245 reset;
#X msg 150 245 gain 2;
#X msg 220 245 rom tx81z-v1.6.bin;
#X text 400 245 save = write battery RAM (also saved on close);
#X obj 40 400 dac~;
#X obj 300 380 route lcd led midiout;
#X obj 300 410 list;
#X obj 300 440 unpack s s;
#X symbolatom 300 470 18 0 0 0 - - - 0;
#X symbolatom 300 495 18 0 0 0 - - - 0;
#X floatatom 470 410 5 0 0 0 - - - 0;
#X text 520 410 LEDs (bitmask);
#X obj 560 440 print MIDIOUT;
#X text 40 540 LCD + LEDs as OSC: /tx81z/lcd <line1> <line2> \, /tx81z/led <mask>;
#X obj 40 570 oscformat tx81z lcd;
#X obj 220 570 list;
#X obj 220 600 oscformat tx81z led;
#X obj 40 640 list prepend send;
#X obj 40 670 list trim;
#X obj 40 700 netsend -u -b;
#X obj 400 600 loadbang;
#X msg 400 630 connect localhost 9000;
#X text 400 660 change host / port here;
#X floatatom 40 730 3 0 0 0 - - - 0;
#X text 40 780 PROGRAM CHANGE: bank I/A/B/C + patch 1-32 (I01-C32 = 0-127 \, bank D cannot be reached via program change);
#X text 40 810 bank;
#X obj 90 810 hradio 18 1 0 4 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0;
#X text 90 830 I  A  B  C;
#X text 200 810 patch;
#X floatatom 250 810 4 1 32 0 - - - 0;
#X obj 250 840 clip 1 32;
#X obj 250 865 - 1;
#X obj 250 890 t f f;
#X obj 160 920 f;
#X obj 90 860 * 32;
#X obj 90 890 t b f;
#X obj 250 950 +;
#X msg 250 980 pgm \$1;
